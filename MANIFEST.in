include README.md CONTRIBUTING.md LICENSE
recursive-include cppbuild *.py
recursive-include examples *.py
recursive-include tests *.py
recursive-include deliverables *.md
prune .test-work
prune build
prune dist
prune references
prune .git
prune .codex
prune .agents
global-exclude __pycache__ *.py[cod] .env .env.*
